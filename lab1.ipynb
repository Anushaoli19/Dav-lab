    "import numpy as np\n",
    "\n",
    "\n",
    "arr = np.array([20, 57, 59, 97, 56])\n",
    "print(\"array:\", arr)\n",
    "print(\"mean:\", arr.mean())\n",
    "print(\"reshaped 2D:\\n\", arr.reshape(5, 1))\n",
    "print(\"sliced(index 1 to 3):\", arr[1:4])"
   ]
